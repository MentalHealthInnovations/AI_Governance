  "sandbox": {
    "enabled": true,
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "ignoreViolations": {},
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [],
    "allowUnsandboxedCommands": false,

    "filesystem": {
      "allowRead": [
        ".",
        "~/.config/gh/config.yml",
        "~/.config/gh/hosts.yml"
      ],
      "allowWrite": [
        ".",
        "./tmp",
        "./build",
        "./dist",
        "./coverage",
        "./.git/refs/**",
        "./.git/objects/**",
        "./.git/logs/**",
        "./.git/COMMIT_EDITMSG",
        "./.git/MERGE_MSG",
        "./.git/MERGE_HEAD",
        "./.git/index",
        "./.git/index.lock",
        "./.git/HEAD",
        "./.git/HEAD.lock",
        "./.git/ORIG_HEAD",
        "./.git/FETCH_HEAD",
        "./.git/packed-refs",
        "./.git/packed-refs.lock"
      ],
      "_comment_ghConfig": "~/.config/gh is deliberately absent from denyRead, and the two files gh reads to authenticate are named in allowRead above. Leaving them out of denyRead is not enough on its own: Read and Edit permission denies merge into the sandbox filesystem boundary, so Read(~/.config/gh/**) below also stopped the gh binary from reading its own config under sandboxed Bash, and every gh invocation failed with 'failed to load config: operation not permitted'. The allowRead entries name config.yml and hosts.yml exactly, so they are more specific than the deny region they sit inside and re-open only those two files rather than the directory. The permission deny still applies to the Read tool, which is evaluated for the tool call and not by the sandbox, so the agent cannot read the token even though the binary can. Two controls cover the rest: the gh_config_path pre-block in bash-policy-check.sh refuses any Bash command naming these paths, and the GITHUB_PAT pattern in lib/redact.sh redacts a gho_/ghp_ token that reaches tool output another way. Residual: the sandbox boundary is per command, not per binary, so a sandboxed command that reaches these two files without naming them literally is not stopped by the OS layer. Narrowing this further means dropping the permission deny and moving the agent-level block into a PreToolUse hook, which is the route to take if a gh release starts reading a third file here.",
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.config/gcloud",
        "~/.gnupg",
        "~/.npmrc",
        "~/.netrc",
        "~/.docker",
        "~/.kube",
        "~/.terraform.d",
        "~/.terraformrc",
        "~/.vault-token",
        "~/Library/Keychains",
        "~/.pypirc",
        "~/.gem",
        "~/.cargo/credentials",
        "~/.config/op"
      ],
      "denyWrite": [
        "/etc",
        "/usr/local/bin",
        "~/.ssh",
        "~/.aws",
        "~/.azure",
        "~/.config/gcloud",
        "~/.gnupg",
        "~/.npmrc",
        "~/.netrc",
        "~/.docker",
        "~/.kube",
        "~/.terraform.d",
        "~/.terraformrc",
        "~/.vault-token",
        "~/Library/Keychains"
      ],
      "allowManagedReadPathsOnly": true
    },

    "network": {
      "_comment_allowedDomains": "Source of truth for the WebFetch domain allowlist. webfetch-policy-check.sh reads this list at runtime, so adding or removing a hostname here updates both the OS sandbox and the hook in lockstep. Bare hostnames only — no subdomain wildcards (list each subdomain explicitly) and no path component (a '/' makes the entry invalid). The OS sandbox allows every path on a listed host; to narrow WebFetch to a path prefix, add the host to _webfetchPathScopes below.",
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": false,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "proxy.golang.org",
        "crates.io",
        "index.crates.io",
        "opentofu.org",
        "developer.hashicorp.com",
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "hub.docker.com",
        "public.ecr.aws",
        "api.ecr-public.aws",
        "mentalhealthinnovations.org",
        "themix.org.uk",
        "giveusashout.org",
        "code.claude.com",
        "www.twilio.com",
        "learn.jamf.com",
        "learn.microsoft.com",
        "community.jamf.com",
        "docs.aws.amazon.com",
        "pricing.us-east-1.amazonaws.com",
        "developer.salesforce.com",
        "help.salesforce.com",
        "resources.docs.salesforce.com",
        "architect.salesforce.com",
        "docs.github.com",
        "mcp.atlassian.com",
        "support.atlassian.com",
        "developer.atlassian.com",
        "community.atlassian.com",
        "espocrm.com",
        "www.espocrm.com",
        "docs.espocrm.com",
        "forum.espocrm.com"
      ],
      "_comment_webfetchPathScopes": "WebFetch-only path tightening, read solely by webfetch-policy-check.sh. Each key is a host that also appears in allowedDomains; its value is a path prefix that WebFetch URLs to that host must fall under (exact match or a '/'-bounded child). Hosts not listed here are unrestricted. This does NOT constrain Bash network egress — the OS sandbox sees host only and allows every path — so treat it as a WebFetch convenience/blast-radius control, not a hard boundary.",
      "_webfetchPathScopes": {
        "opentofu.org": "/docs",
        "developer.hashicorp.com": "/terraform"
      },
      "allowManagedDomainsOnly": true
    }
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/bash-policy-check.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/webfetch-policy-check.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/mcp-policy-check.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/pii-path-policy-check.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/pii-content-sniff.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Task|SlashCommand|Read",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/tool-audit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/output-redact.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/prompt-submit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/session-audit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/session-audit.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/claude/hooks/session-audit.sh"
          }
        ]
      }
    ]
  }
}
